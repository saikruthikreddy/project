{
	"version": "2.0",
	"extensionBundle": {
		"id": "Microsoft.Azure.Functions.ExtensionBundle",
		"version": "[4.0.0, 5.0.0)"
	},
	"extensions": {
		"serviceBus": {
			"maxConcurrentCalls": 16,
			"autoCompleteMessages": true,
			"autoRenewTimeout": "00:05:00"
		}
	},
	"logging": {
		"applicationInsights": {
			"samplingSettings": {
				"isEnabled": true
			}
		}
	}
}
